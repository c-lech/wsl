# --------------------------------------------------------------------------
# WSL interop
# --------------------------------------------------------------------------

# Repair WSL bridge/interop when broken (auto-detects the Windows socket)
alias checkbridge='bash ~/wsl/checkbridge.sh || { for s in $(ls -t /run/WSL/*_interop); do WSL_INTEROP="$s" timeout 5 cmd.exe /c ver >/dev/null 2>&1 && { export WSL_INTEROP="$s"; echo "bridge OK (repaired: $s)"; break; }; done; }'

# --------------------------------------------------------------------------
# wsl tools — clipboard, screenshots, tmux helpers (scripts in ~/wsl/)
# --------------------------------------------------------------------------

# Clipboard auto-detect: image -> saveimg, text -> savecode (see save -h)
alias save='$HOME/wsl/save.sh'
# Clipboard image -> ~/projects/saved/images/
alias saveimg='$HOME/wsl/saveimg.sh'
# Clipboard text/code -> ~/projects/saved/code/ as PNG (silicon)
alias savecode='$HOME/wsl/savecode.sh'
# tmux with N panes; tm == tmux == "tm 1"
alias tm='$HOME/wsl/tmux.sh'
# ssh to a saved server, fuzzy picker
alias s='$HOME/wsl/enterssh.sh'
# Save whole current tmux pane -> saved/logs/
alias savepane='$HOME/wsl/savepane.sh'
# Save every tmux pane in the session -> saved/logs/
alias savetmux='$HOME/wsl/savetmux.sh'
# Run a command, save its output -> saved/logs/
alias savecmd='$HOME/wsl/savecmd.sh'
# Save Windows clipboard text -> saved/logs/
alias savetxt='$HOME/wsl/savetxt.sh'
# Run a command, save a styled terminal screenshot -> saved/images/
alias saveshot='$HOME/wsl/saveshot.sh'
# Notify when a long command finishes. Use like:  sleep 10; alert
alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'
